{
  "name": "leadflow",
  "private": true,
  "workspaces": ["apps/*"],
  "scripts": {
    "dev": "concurrently \"npm run dev -w @leadflow/api\" \"npm run dev -w @leadflow/web\"",
    "build": "npm run build -w @leadflow/api && npm run build -w @leadflow/web",
    "test": "npm run test -w @leadflow/api",
    "db:generate": "npm run db:generate -w @leadflow/api",
    "db:migrate": "npm run db:migrate -w @leadflow/api",
    "db:seed": "npm run db:seed -w @leadflow/api"
  },
  "devDependencies": {
    "concurrently": "^9.2.0"
  }
}
